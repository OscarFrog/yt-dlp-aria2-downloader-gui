# SPDX-License-Identifier: MIT
# Repository-local Codex guardrails. These rules supplement task authority and
# AGENTS.md; they do not grant permission for an external mutation.

# Prefix rules cannot express an end-of-argv constraint, and the strictest
# matching decision wins. Review direct Git commands. The tracked inspection
# helper uses the ordinary sandbox/baseline policy instead of receiving an
# execution-policy exemption.
prefix_rule(
    pattern = [["git", "/usr/bin/git", "/bin/git"]],
    decision = "prompt",
    justification = "Review direct Git commands. Use the fixed tracked helper for unattended read-only inspection.",
    match = [
        "git status --short --branch",
        "git diff --check",
        "git add download-video-gui.sh",
        "git commit -m update",
        "git update-ref refs/heads/main HEAD",
        "git push origin feature-branch",
        "/usr/bin/git tag v9.9.9",
    ],
    not_match = [
        "./scripts/git-inspect.sh status",
        "gh pr view 56",
        "env git status",
    ],
)

# Global Git options can change command resolution or target another worktree.
# Review those forms because the subcommand alone cannot identify the target.
prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/bin/git"],
        [
            "-C",
            "-c",
            "--bare",
            "--config-env",
            "--exec-path",
            "--git-dir",
            "--namespace",
            "--work-tree",
        ],
    ],
    decision = "prompt",
    justification = "Review Git global options that can redirect repository state or command resolution.",
    match = [
        "git -C . status",
        "git --git-dir .git status",
        "/usr/bin/git -c alias.publish=push publish origin main",
    ],
    not_match = [
        "git status",
        "git diff --check",
        "git push origin feature-branch",
    ],
)

prefix_rule(
    pattern = [["gh", "/usr/bin/gh", "/bin/gh"]],
    decision = "prompt",
    justification = "Review the GitHub repository, operation and delegated task scope.",
    match = [
        "gh pr view 56",
        "gh --repo owner/repository pr merge 56",
        "/usr/bin/gh -R owner/repository release create v9.9.9",
    ],
    not_match = [
        "git status",
        "env gh pr view 56",
    ],
)

# Environment wrappers obscure the executable position from exact-prefix rules.
# Route wrapped commands to the reviewer as well.
prefix_rule(
    pattern = [["env", "/usr/bin/env"]],
    decision = "prompt",
    justification = "Review environment-wrapped commands because the wrapped executable is not at argv[0].",
    match = [
        "env git push origin feature-branch",
        "env GH_HOST=github.com gh pr merge 56",
    ],
    not_match = [
        "git status",
        "gh pr view 56",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Review the named remote, destination ref and pre-push hook under the assigned delivery or release scope.",
    match = [
        "git push",
        "git push origin feature-branch",
        "git push --set-upstream origin feature-branch",
    ],
    not_match = [
        "git status",
        "git fetch origin",
    ],
)

# Prompt for every direct tag invocation because option-free and configurable
# forms can create or replace tags as well as list them.
prefix_rule(
    pattern = ["git", "tag"],
    decision = "prompt",
    justification = "Review tag operations. Creating a release tag requires the requested version and authorized signing identity.",
    match = [
        "git tag v9.9.9",
        "git tag -s v9.9.9",
        "git tag --list",
    ],
    not_match = [
        "git show v9.9.9",
        "git describe --tags",
    ],
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "prompt",
    justification = "Review the target and respect the protected pull-request delivery path.",
    match = [
        "git merge --ff-only feature-branch",
        "git merge --abort",
    ],
    not_match = [
        "git merge-base main feature-branch",
        "git status",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Review the qualified PR head, squash method, required checks and source-branch retention.",
    match = [
        "gh pr merge 56 --squash --match-head-commit 0123456789abcdef0123456789abcdef01234567",
    ],
    not_match = [
        "gh pr view 56",
        "gh pr checks 56",
    ],
)

prefix_rule(
    pattern = ["gh", "release", ["create", "delete", "edit", "upload"]],
    decision = "prompt",
    justification = "Changing release assets or metadata requires explicit release authority.",
    match = [
        "gh release create v9.9.9",
        "gh release upload v9.9.9 package.rpm",
    ],
    not_match = [
        "gh release view v9.9.9",
        "gh release verify v9.9.9",
    ],
)

prefix_rule(
    pattern = ["gh", "workflow", "run"],
    decision = "prompt",
    justification = "Review the workflow, ref and assigned CI scope. Publication requires a request for the named version.",
    match = [
        "gh workflow run qualification.yml",
    ],
    not_match = [
        "gh workflow view qualification.yml",
        "gh run view 123456",
    ],
)

prefix_rule(
    pattern = ["gh", "run", ["rerun", "cancel", "delete"]],
    decision = "prompt",
    justification = "Changing an existing workflow run requires explicit task authority.",
    match = [
        "gh run rerun 123456",
        "gh run cancel 123456",
    ],
    not_match = [
        "gh run view 123456",
        "gh run watch 123456",
    ],
)

# The reviewer also checks deletion refspecs and options appearing later in argv.
prefix_rule(
    pattern = [["git", "/usr/bin/git", "/bin/git"], ["branch", "tag"], ["-d", "-D", "--delete"]],
    decision = "forbidden",
    justification = "Preserve local branches and tags.",
    match = ["git branch -D feature", "git tag --delete v1.2.3"],
    not_match = ["git branch --list", "git tag -s v1.2.3"],
)

prefix_rule(
    pattern = [["git", "/usr/bin/git", "/bin/git"], "push", ["-d", "--delete"]],
    decision = "forbidden",
    justification = "Preserve remote branches and tags.",
    match = ["git push --delete origin feature", "git push -d origin refs/tags/v1.2.3"],
    not_match = ["git push --set-upstream origin feature"],
)

prefix_rule(
    pattern = [["git", "/usr/bin/git", "/bin/git"], "push", "origin", ["-d", "--delete"]],
    decision = "forbidden",
    justification = "Preserve remote branches and tags when origin precedes the deletion flag.",
    match = ["git push origin --delete feature"],
    not_match = ["git push origin feature"],
)

prefix_rule(
    pattern = [["gh", "/usr/bin/gh", "/bin/gh"], "pr", "merge", ["--admin", "--delete-branch", "-d"]],
    decision = "forbidden",
    justification = "Keep branch protections and retain the PR source branch.",
    match = ["gh pr merge --admin 56", "gh pr merge --delete-branch 56"],
    not_match = ["gh pr merge --squash 56"],
)

# Forbid common direct force-push spellings that name main or an equivalent
# destination ref. The general Git rule still prompts for non-canonical
# wrappers, remotes, and option arrangements before they may leave the sandbox.
prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/bin/git"],
        "push",
        ["--force", "-f", "--force-with-lease", "--force-with-lease=main", "--force-with-lease=refs/heads/main"],
        "origin",
        ["main", "HEAD:main", "HEAD:refs/heads/main", "main:main", "refs/heads/main"],
    ],
    decision = "forbidden",
    justification = "Never force-push main; deliver through a reviewed pull request.",
    match = [
        "git push --force origin main",
        "git push --force origin HEAD:main",
        "/usr/bin/git push --force-with-lease origin HEAD:refs/heads/main",
    ],
    not_match = [
        "git push --force origin feature-branch",
        "git push origin main",
    ],
)

prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/bin/git"],
        "push",
        "origin",
        ["--force", "-f", "--force-with-lease", "--force-with-lease=main", "--force-with-lease=refs/heads/main"],
        ["main", "HEAD:main", "HEAD:refs/heads/main", "main:main", "refs/heads/main"],
    ],
    decision = "forbidden",
    justification = "Never force-push main; deliver through a reviewed pull request.",
    match = [
        "git push origin -f main",
        "git push origin --force HEAD:main",
    ],
    not_match = [
        "git push origin --force feature-branch",
        "git push origin main",
    ],
)

prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/bin/git"],
        "push",
        "origin",
        ["main", "HEAD:main", "HEAD:refs/heads/main", "main:main", "refs/heads/main"],
        ["--force", "-f", "--force-with-lease", "--force-with-lease=main", "--force-with-lease=refs/heads/main"],
    ],
    decision = "forbidden",
    justification = "Never force-push main; deliver through a reviewed pull request.",
    match = [
        "git push origin main --force",
        "git push origin HEAD:main --force",
        "git push origin main:main --force-with-lease",
    ],
    not_match = [
        "git push origin feature-branch --force",
        "git push origin main",
    ],
)

prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/bin/git"],
        "push",
        ["--force-with-lease=main", "--force-with-lease=refs/heads/main"],
    ],
    decision = "forbidden",
    justification = "Never force-push main; deliver through a reviewed pull request.",
    match = [
        "git push --force-with-lease=main origin",
        "git push --force-with-lease=refs/heads/main origin",
    ],
    not_match = [
        "git push --force-with-lease=feature-branch origin feature-branch",
        "git push --force-with-lease origin feature-branch",
    ],
)

prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/bin/git"],
        "push",
        "origin",
        ["--force-with-lease=main", "--force-with-lease=refs/heads/main"],
    ],
    decision = "forbidden",
    justification = "Never force-push main; deliver through a reviewed pull request.",
    match = [
        "git push origin --force-with-lease=main",
        "git push origin --force-with-lease=refs/heads/main",
    ],
    not_match = [
        "git push origin --force-with-lease=feature-branch feature-branch",
        "git push origin --force-with-lease feature-branch",
    ],
)

prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/bin/git"],
        "push",
        "origin",
        ["+main", "+HEAD:main", "+HEAD:refs/heads/main", "+main:main"],
    ],
    decision = "forbidden",
    justification = "Never force-push main with a force refspec; deliver through a reviewed pull request.",
    match = [
        "git push origin +main",
        "git push origin +HEAD:main",
    ],
    not_match = [
        "git push origin +feature-branch",
        "git push origin main",
    ],
)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
indent_style = space
indent_size = 4
binary_next_line = true
switch_case_indent = true
simplify = false
space_redirects = false
keep_padding = false
function_next_line = false
minify = false

[packaging/deb/postinst]
shell_variant = posix
indent_style = space
indent_size = 4
binary_next_line = true
switch_case_indent = true
simplify = false

[packaging/deb/prerm]
shell_variant = posix
indent_style = space
indent_size = 4
binary_next_line = true
switch_case_indent = true
simplify = false

[packaging/deb/postrm]
shell_variant = posix
indent_style = space
indent_size = 4
binary_next_line = true
switch_case_indent = true
simplify = false

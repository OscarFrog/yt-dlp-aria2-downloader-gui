set -e

# Final HOME cleanup is deliberately performed from prerm while the helper
# still exists in the package payload.
case "${1:-}" in
    remove | purge | upgrade | failed-upgrade | abort-install | abort-upgrade | disappear)
        :
        ;;
    *)
        :
        ;;
esac

exit 0

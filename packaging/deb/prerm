#!/bin/sh
# SPDX-License-Identifier: MIT
set -e

HELPER='/usr/lib/yt-dlp-aria2-downloader/package-user-cleanup.sh'

case "${1:-}" in
remove)
    # "prerm remove in-favour ..." is replacement, not final erase.
    if [ "$#" -eq 1 ] && [ -x "${HELPER}" ]; then
        if ! "${HELPER}" --all-users; then
            printf '%s\n' \
                'Warning: some yt-dlp-aria2-downloader user data could not be cleaned; package removal will continue.' \
                >&2
        fi
    fi
    ;;

upgrade|deconfigure|failed-upgrade)
    :
    ;;

*)
    :
    ;;
esac

exit 0
